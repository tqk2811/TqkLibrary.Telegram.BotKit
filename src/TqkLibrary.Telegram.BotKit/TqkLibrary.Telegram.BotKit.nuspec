<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<!--https://docs.microsoft.com/en-us/nuget/reference/nuspec-->
	<metadata>
		<id>$id$</id>
		<version>$version$</version>
		<description>Lightweight DI/attribute-driven framework for building Telegram bots on top of Telegram.Bot — commands, callback routes, regex handlers and per-chat state with localization support.</description>
		<authors>tqk2811</authors>
		<projectUrl>https://github.com/tqk2811/TqkLibrary.Telegram.BotKit</projectUrl>
		<repository type="git" url="https://github.com/tqk2811/TqkLibrary.Telegram.BotKit.git"/>
		<license type="expression">MIT</license>
		<readme>docs\README.md</readme>
		<dependencies>
			<group targetFramework="netstandard2.0">
				<dependency id="Telegram.Bot" version="22.9.6.2" />
				<dependency id="Microsoft.Extensions.Caching.Memory" version="10.0.7" />
				<dependency id="Microsoft.Extensions.DependencyInjection" version="10.0.7" />
				<dependency id="Microsoft.Extensions.Localization" version="10.0.7" />
				<dependency id="TqkLibrary.CompilerServices" version="1.0.0.3" />
			</group>
			<group targetFramework="net6.0">
				<dependency id="Telegram.Bot" version="22.9.6.2" />
				<dependency id="Microsoft.Extensions.Caching.Memory" version="10.0.7" />
				<dependency id="Microsoft.Extensions.DependencyInjection" version="10.0.7" />
				<dependency id="Microsoft.Extensions.Localization" version="10.0.7" />
			</group>
			<group targetFramework="net8.0">
				<dependency id="Telegram.Bot" version="22.9.6.2" />
				<dependency id="Microsoft.Extensions.Caching.Memory" version="10.0.7" />
				<dependency id="Microsoft.Extensions.DependencyInjection" version="10.0.7" />
				<dependency id="Microsoft.Extensions.Localization" version="10.0.7" />
			</group>
			<group targetFramework="net10.0">
				<dependency id="Telegram.Bot" version="22.9.6.2" />
				<dependency id="Microsoft.Extensions.Caching.Memory" version="10.0.7" />
				<dependency id="Microsoft.Extensions.DependencyInjection" version="10.0.7" />
				<dependency id="Microsoft.Extensions.Localization" version="10.0.7" />
			</group>
		</dependencies>
	</metadata>
	<files>
		<file src="..\..\README.md" target="docs\" />
		<file src="bin\Release\netstandard2.0\TqkLibrary.Telegram.BotKit.dll" target="lib\netstandard2.0\" />
		<file src="bin\Release\net6.0\TqkLibrary.Telegram.BotKit.dll" target="lib\net6.0\" />
		<file src="bin\Release\net8.0\TqkLibrary.Telegram.BotKit.dll" target="lib\net8.0\" />
		<file src="bin\Release\net10.0\TqkLibrary.Telegram.BotKit.dll" target="lib\net10.0\" />
	</files>
</package>
